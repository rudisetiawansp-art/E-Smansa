<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <RelativeLayout
        android:id="@+id/cardnya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/recycler_fotonya"
            android:layout_marginEnd="8dp"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:adjustViewBounds="true"
            android:src="@drawable/logo" />

        <TextView
            android:layout_toEndOf="@id/recycler_fotonya"
            android:id="@+id/recycler_nama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/recycler_more"
            android:text="Nama"
            android:textColor="?colorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/recycler_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_more" />

        <LinearLayout
            android:layout_toEndOf="@id/recycler_fotonya"
            android:id="@+id/ll_kelas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/recycler_nama"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recyler_kelas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Kelas"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/recyler_jamke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Jam ke : "
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_toEndOf="@id/recycler_fotonya"
            android:id="@+id/recyler_keperluan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_kelas"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Keperluannya"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/recycler_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/recyler_keperluan"
            android:layout_marginTop="8dp"
            android:gravity="right"
            android:text="Waktunya"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recycler_dibuatoleh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/recycler_timestamp"
            android:gravity="right"
            android:text="Dibuat Oleh: "
            android:textSize="14sp" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>